{
  "name": "seo-tryanderror",
  "version": "0.1.0",
  "private": true,
  "description": "C: autonomous site growth engine (understand -> discover -> prioritize -> propose)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
