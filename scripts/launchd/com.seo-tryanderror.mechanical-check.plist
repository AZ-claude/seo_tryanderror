<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template only — not installed automatically. See README.md "Scheduler
  (mechanical-only)" for install/uninstall instructions.

  Runs scripts/scheduled-mechanical-check.sh (understand + review
  --dump-inputs for every real site config) once a day. Does not run
  discover/prioritize/propose/apply — those stay manually triggered.

  Before installing, replace:
    - REPO_PATH: absolute path to this checked-out repo
    - GSC_SERVICE_ACCOUNT_JSON_PATH: absolute path to the GSC service
      account JSON (never commit the real value anywhere else)
    - HOME_PATH: absolute path to the installing user's home directory
      (e.g. /Users/yourname) — needed because on this machine node/npm are
      managed by mise and only resolve via its shim directory
      ($HOME/.local/share/mise/shims), which is NOT on the default
      /usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin PATH launchd jobs get.
      Verify with `command -v node`/`command -v npm` under whatever PATH
      you actually configure here before installing — do NOT source a
      shell init file (.zshrc/.bashrc/mise activate) to solve this, a
      LaunchAgent has no interactive shell to source it in.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.seo-tryanderror.mechanical-check</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPO_PATH/scripts/scheduled-mechanical-check.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>REPO_PATH</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>GSC_SERVICE_ACCOUNT_JSON</key>
		<string>GSC_SERVICE_ACCOUNT_JSON_PATH</string>
		<key>PATH</key>
		<string>HOME_PATH/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>REPO_PATH/logs/scheduled/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>REPO_PATH/logs/scheduled/launchd.err.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
