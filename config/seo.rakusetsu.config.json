{
  "schemaVersion": 2,
  "site": {
    "key": "rakusetsu-main",
    "baseUrl": "https://rakusetsu.com",
    "mode": "existing",
    "reader": "http",
    "repoRoot": null,
    "contentRoot": null,
    "maxPages": 300
  },
  "gsc": {
    "property": "sc-domain:rakusetsu.com",
    "credentialsEnv": "GSC_SERVICE_ACCOUNT_JSON",
    "defaultWindowDays": 28,
    "reviewWindowDays": 7,
    "finalDataLagDays": 3,
    "excludePagePrefix": "https://pokeca.rakusetsu.com/"
  },
  "experiment": {
    "cooldownDays": 7,
    "maxActiveExperiments": 3
  },
  "commands": {
    "build": null,
    "test": null
  },
  "adapters": {
    "writer": "stub",
    "site": "http-readonly",
    "search": "fixture"
  }
}
