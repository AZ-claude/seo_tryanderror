{
  "schemaVersion": 1,
  "site": {
    "baseUrl": "https://example.com",
    "repoRoot": ".",
    "contentRoot": "content"
  },
  "gsc": {
    "property": "sc-domain:example.com",
    "credentialsEnv": "GSC_SERVICE_ACCOUNT_JSON",
    "defaultWindowDays": 28,
    "reviewWindowDays": 7,
    "finalDataLagDays": 3
