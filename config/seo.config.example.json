  "experiment": {
    "cooldownDays": 7,
    "oneKeywordPerRun": true
  },
  "commands": {
    "build": "npm run build",
    "test": "npm test"
  },
  "adapters": {
    "writer": "stub",
    "site": "fixture",
    "search": "fixture"
  }
}
